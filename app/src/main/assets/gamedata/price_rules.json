{
  "tradeTypesRegex": {
    "buy": "(?<objDesc>.*) \\((?:for sale|unpaid), (?<objPrice>[0-9]+) zorkmids\\)",
    "sell": "offers (?<objPrice>[0-9]+) gold pieces for your (?<objDesc>.*)\\."
  },
  "objectTypesRegex": {
    "Potion": "potion",
    "Scroll": "scroll",
    "Spellbook": "spellbook",
    "Ring": "ring",
    "Wand": "wand",
    "Amulet": "amulet",
    "Boots": "(?:shoes|boots)",
    "Cloak": "(?:apron|robe|smock|mantelet|pall|cape|cope|cloak|cloth)",
    "Helm": "(?:fedora|cap|cornuthaum|helm|pot|hat|helmet)",
    "Gloves": "(?:gauntlets|gloves)",
    "Shield": "(?:shield|roundshield)"
  }
}
