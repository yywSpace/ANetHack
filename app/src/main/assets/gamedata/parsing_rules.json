{
  "tradeTypesRegex": {
    "buy": "(?<objDesc>.*) \\((?:for sale|unpaid), (?<objPrice>[0-9]+) zorkmids\\)",
    "sell": "offers (?<objPrice>[0-9]+) gold pieces for your (?<objDesc>.*)\\."
  },
  "objectTypesRegex": {
    "Potion": "\\bpotions?\\b(?:\\s+of\\b.*)?",
    "Scroll": "\\bscrolls?\\b(?:\\s+of\\b.*)?",
    "Spellbook": "\\b(?:spellbook|book|novel)\\b(?:\\s+of\\b.*)?",
    "Ring": "\\bring\\s+of\\b.*|\\bring\\b",
    "Wand": "\\bwand\\b(?:\\s+of\\b.*)?",
    "Amulet": "\\bamulet\\b(?:\\s+of\\b.*)?",
    "Boots": "\\b(?:shoes|boots)\\b",
    "Cloak": "\\b(?:apron|robe|smock|mantelet|pall|cape|cope|cloak|cloth|wrapping)\\b",
    "Helm": "\\b(?:fedora|cap|cornuthaum|helm|pot|hat|helmet)\\b",
    "Gloves": "\\b(?:gauntlets|gloves)\\b",
    "Shield": "\\b(?:shield|roundshield)\\b",
    "Weapon": "\\b(?:weapon|sword|broadsword|runesword|axe|bow|crossbow|dagger|daggers|knife|knives|knifes|crysknife|crysknives|spears?|lance|mace|hammer|club|staff|quarterstaff|whip|bullwhip|flail|trident|saber|katana|arrows?|bolts?|darts?|shurikens?|boomerangs?|sling|scimitar|tsurugi|partisan|ranseur|spetum|glaive|halberd|bardiche|voulge|fauchard|guisarme|mattock|morning star|aklys|yumi|javelins?|athames?|scalpels?|stilettos?|worm tooth|worm teeth|yas?|bec de corbin|rubber hose)",
    "Tool": "\\b(?:tool|sack|bag|key|pick-axe|pick|candle|lamp|lantern|whistle|flute|horn|harp|drum|bottle|jug|oilskin|box|chest|camera|mirror|balls?|lenses|blindfold|towel|saddle|leash|stethoscope|kit|opener|can|card|figurine|marker|mine|beartrap|bell|bugle|hook|Candelabrum|Invocation|Opening)",
    "Food": "\\b(?:food|rations?|cookies?|pies?|cakes?|apples?|oranges?|bananas?|carrots?|eggs?|meat|meatballs?|meat ring|bread|cheese|corpse|tin|loaf|kelp|leaf|pears?|melons?|wolfsbane|garlic|mold|jelly|candy|wafer|pancakes?)",
    "Gem": "^(?!.*\\bwand\\b).*?\\b(?:gem|stone|glass|crystal|diamond|ruby|sapphire|emerald|opal|jade|agate|topaz|garnet|amethyst|jasper|obsidian|turquoise|aquamarine|citrine|amber|chrysoberyl|fluorite|jacinth|jet|flint|rock|luckstone|loadstone|touchstone)",
    "Suit": "\\b(?:suit|armor|mail|scales|plate|chain|mithril|coat|ring mail|leather jacket)",
    "Shirt": "\\bshirt"
  },
  "monsterNameSuffixRegex": "\\s*\\((?:human|animal)\\)\\s*$"
}
