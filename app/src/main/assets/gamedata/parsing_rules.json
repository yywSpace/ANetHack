{
  "tradeTypesRegex": {
    "buy": "(?<objDesc>.*) \\((?:for sale|unpaid), (?<objPrice>[0-9]+) zorkmids\\)",
    "sell": "offers (?<objPrice>[0-9]+) gold pieces for your (?<objDesc>.*)\\."
  },
  "objectTypesRegex": {
    "Potion": "\\bpotion",
    "Scroll": "\\bscroll",
    "Spellbook": "\\b(?:spellbook|book|novel)",
    "Ring": "\\bring",
    "Wand": "\\bwand",
    "Amulet": "\\bamulet",
    "Boots": "\\b(?:boots|shoes)",
    "Cloak": "\\b(?:cloak|cape|robe|smock|mantelet|pall|cope|cloth|wrapping)",
    "Helm": "\\b(?:helm|helmet|hat|cap|fedora|cornuthaum|pot)",
    "Gloves": "\\b(?:gloves|gauntlets)",
    "Shield": "\\b(?:shield|roundshield)",
    "Suit": "\\b(?:suit|armor|mail)",
    "Shirt": "\\bshirt",
    "Weapon": "\\bweapon",
    "Tool": "\\btool",
    "Food": "\\bfood",
    "Gem": "\\b(?:gem|stone)"
  },
  "monsterNameSuffixRegex": "\\s*\\((?:human|animal)\\)\\s*$"
}
