{
  "tradeTypesRegex": {
    "buy": "(?<objDesc>.*) \\((?:for sale|unpaid), (?<objPrice>[0-9]+) zorkmids\\)",
    "sell": "offers (?<objPrice>[0-9]+) gold pieces for your (?<objDesc>.*)\\."
  },
  "objectTypesRegex": {
    "Potion": "\\bpotions?",
    "Scroll": "\\bscrolls?",
    "Spellbook": "\\bspellbook",
    "Ring": "(?<!meat )\\bring(?!\\s+mail)",
    "Wand": "\\bwand",
    "Amulet": "\\bamulet"
  }
}
