# Android is not a multi-user system, allow any user hear
WIZARDS=*
EXPLORERS=*

# Not needed: the save file name already contains the save/ prefix, so the
# game would look for save/save/... and saving would fail.
#SAVEDIR=save
# In-progress level files (kept out of save/ so it only holds save files).
LEVELDIR=levels
# Bones files.
BONESDIR=bones
# Scoreboard and log files (record, logfile, xlogfile, livelog).
SCOREDIR=score

# A dump log is a log that is written when the game is
# over. It contains a view of the map and a record of
# the player's belonging, attributes, etc.
#
# %D = ending date+time (YYYYMMDDhhmmss), %n = player name.
DUMPLOGFILE=/data/user/0/com.yywspace.anethack/files/logs/dump/%D_%n.log