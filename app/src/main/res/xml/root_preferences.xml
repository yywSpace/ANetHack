<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        app:title="@string/pref_ui_header"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="themeMode"
            app:title="@string/pref_ui_theme_mode"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="system"
            app:entries="@array/theme_mode_array"
            app:entryValues="@array/theme_mode_value"/>

        <CheckBoxPreference
            app:key="immersiveMode"
            app:title="@string/pref_ui_immersive_mode"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_ui_immersive_mode_desc"/>

        <CheckBoxPreference
            app:key="textReflow"
            app:title="@string/pref_ui_text_reflow"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_ui_text_reflow_desc"/>

        <CheckBoxPreference
            app:key="priceId"
            app:title="@string/pref_price_id_enable"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_price_id_enable_desc"/>

        <CheckBoxPreference
            app:key="monsterInfo"
            app:title="@string/pref_monster_info_enable"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_monster_info_enable_desc"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_map_header"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="tileSet"
            app:title="@string/pref_map_tileset"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="ascii"
            app:entries="@array/map_tile_array"
            app:entryValues="@array/map_tile_value"/>

        <CheckBoxPreference
            app:key="playAnimations"
            app:title="@string/pref_map_animations"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_map_animations_desc"/>

        <CheckBoxPreference
            app:key="showIndicator"
            app:title="@string/pref_map_indicator"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_map_indicator_desc"/>

        <CheckBoxPreference
            app:key="showLastTravelIndicator"
            app:title="@string/pref_map_last_travel_indicator"
            app:dependency="showIndicator"
            app:iconSpaceReserved="false"
            app:defaultValue="true"/>

        <EditTextPreference
            app:key="indicatorSymbols"
            app:dependency="showIndicator"
            app:title="@string/pref_map_indicator_symbols"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="&#060;&#062;"
            app:iconSpaceReserved="false"/>

        <SeekBarPreference
            app:key="walkRange"
            app:title="@string/pref_map_walk_range"
            android:max="100"
            app:min="0"
            app:defaultValue="70"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"
            app:summary="@string/pref_map_walk_range_desc"/>

        <CheckBoxPreference
            app:key="travelAfterPanned"
            app:title="@string/pref_map_travel_after_panned"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_map_travel_after_panned_desc"/>
        />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_keyboard_header"
        app:iconSpaceReserved="false">



        <Preference
            app:key="commandPanel"
            app:title="@string/pref_keyboard_command_panel"
            app:summary="@string/pref_keyboard_command_panel_desc"
            app:iconSpaceReserved="false"/>

        <CheckBoxPreference
            app:key="keyboardVibrate"
            app:title="@string/pref_keyboard_vibrate"
            app:iconSpaceReserved="false"
            app:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_sound_header"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            app:key="userSound"
            app:title="@string/pref_sound_user"
            app:iconSpaceReserved="false"
            app:defaultValue="false"
            app:summary="@string/pref_sound_user_summery"/>

        <CheckBoxPreference
            app:key="internalSound"
            app:title="@string/pref_sound_internal"
            app:iconSpaceReserved="false"
            app:defaultValue="true"
            app:summary="@string/pref_sound_internal_summery"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_option_header"
        app:iconSpaceReserved="false">

        <Preference
            app:key="optionEdit"
            app:title="@string/pref_option_edit"
            app:useSimpleSummaryProvider="false"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_dump_header"
        app:iconSpaceReserved="false">
        <Preference
            app:key="dumpLog"
            app:title="@string/pref_log_dump"
            app:summary="@string/pref_log_dump_summery"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="clearDumpLog"
            app:title="@string/pref_log_clear"
            app:iconSpaceReserved="false"
            app:summary="@string/pref_log_clear_desc"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_log_header"
        app:iconSpaceReserved="false">
        <Preference
            app:key="appLog"
            app:title="@string/pref_log_app"
            app:summary="@string/pref_log_app_summary"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="lastCrash"
            app:title="@string/pref_log_crash"
            app:summary="@string/pref_log_crash_summary"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="exportLogs"
            app:title="@string/pref_log_export"
            app:summary="@string/pref_log_export_summary"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="clearLogs"
            app:title="@string/pref_log_clear_logs"
            app:summary="@string/pref_log_clear_logs_summary"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>
</PreferenceScreen>
