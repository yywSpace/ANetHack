<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ANetHack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- 所有对话框/菜单的背景统一用应用背景色 -->
        <item name="colorBackgroundFloating">@color/app_background</item>
        <item name="colorSurface">@color/app_background</item>
        <!-- Material 组件的默认文字色（含对话框标题），与界面文字一致 -->
        <item name="colorOnSurface">@color/app_text</item>
        <!-- 长按选择文字时的底色，深色版本见 values-night -->
        <item name="android:textColorHighlight">@color/text_selection_highlight</item>
        <!-- 启动窗口（含 Android 12+ 的 splash 底色）用应用背景色，跟随深浅主题 -->
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Material 的默认窗口/splash 底色也改成应用背景色 -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/app_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>


</resources>