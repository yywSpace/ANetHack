<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="command_item_height">38dp</dimen>
    <!-- 键盘按键四周的边距：相邻按键之间为它的两倍（2dp） -->
    <dimen name="command_item_gap">1dp</dimen>
    <!-- 面板格子之间、面板分组之间的间隙，也用作面板与键盘的上下内边距 -->
    <dimen name="command_item_spacing">2dp</dimen>
    <dimen name="command_bar_item_padding">5dp</dimen>
    <!-- 命令栏整体的左右留白：比按钮内边距稍大一些 -->
    <dimen name="command_bar_panel_padding">5dp</dimen>
    <!-- 按钮最小宽度：文字很短的标签也保证有这么宽（也是最小点击区域） -->
    <dimen name="command_item_min_width">40dp</dimen>
    <!-- 右侧两个图标按钮的宽度：图标是居中的，宽度越小两个图标靠得越近 -->
    <dimen name="command_icon_width">35dp</dimen>
    <!-- 状态栏/消息栏字号：用 sp，跟随系统字体大小设置（14sp ≈ 原 42px@3x） -->
    <dimen name="status_text_size">14sp</dimen>
    <dimen name="message_text_size">14sp</dimen>
</resources>
