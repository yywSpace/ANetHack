<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色模式下的语义颜色（浅色版本在 values/colors.xml）
         地图本身是纯黑，面板/对话框要更亮一些才能和它区分开 -->
    <color name="app_background">#FF1F1F1F</color>
    <color name="app_text">#FFD2D2D2</color>
    <color name="app_text_secondary">#FF9E9E9E</color>
    <color name="key_background">#FF2A2A2A</color>
    <color name="key_border">#FF444444</color>
    <color name="app_divider">#FF3A3A3A</color>
    <color name="bg_extend_search">#FF2A2A2A</color>
    <!-- 怪物弹窗里的信息卡片底色：比 1F1F1F 的背景略亮，能看出分组 -->
    <color name="monster_card">#FF2A2A2A</color>
    <!-- 怪物弹窗里 chip 的底色：要比卡片底色再深/再亮一档 -->
    <color name="monster_chip">#FF3A3A3A</color>
    <!-- 怪物弹窗里可点击文字（Search）的颜色：用主题强调色 -->
    <color name="monster_action">#FFBB86FC</color>
    <!-- 深色下答案格子用低饱和的深灰，避免亮紫配黑底 -->
    <color name="answer_cell">#FF33313C</color>
    <color name="answer_cell_pressed">#FF4A4458</color>
    <color name="answer_cell_text">#FFD2D2D2</color>
    <!-- 菜单项文字：游戏没给颜色（NO_COLOR）时使用；比正文略亮，但不刺眼 -->
    <color name="menu_item_text">#FFE4E4E4</color>
    <!-- 长按选择文字时的选中底色（深色下用半透明琥珀，和深灰背景区分得开） -->
    <color name="text_selection_highlight">#66FFC107</color>
    <!-- 额外面板格子的底色（深色） -->
    <color name="command_extra_item">#FF2C2C2C</color>
</resources>
