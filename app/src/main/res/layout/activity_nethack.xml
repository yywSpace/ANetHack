<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:clickable="true"
    tools:context=".NetHackActivity">

    <!-- 地图固定铺满，键盘等底部控件覆盖在上面，避免地图尺寸变化 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black">

        <com.yywspace.anethack.map.NHMapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/status_message_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true">

            <com.yywspace.anethack.map.NHStatusView
                android:id="@+id/status_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.yywspace.anethack.map.NHMessageView
                android:id="@+id/message_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部操作区覆盖在地图上，不参与地图测量 -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/app_background"
        android:orientation="vertical">

        <com.yywspace.anethack.keybord.NHKeyboardView
            android:id="@+id/keyboard_view"
            android:background="@color/app_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/command_item_spacing"
            android:paddingBottom="@dimen/command_item_spacing" />

        <com.yywspace.anethack.keybord.NHExtraCommandPanel
            android:id="@+id/extra_command_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/command_item_spacing"
            android:paddingTop="@dimen/command_item_spacing"
            android:paddingEnd="@dimen/command_item_spacing"
            android:paddingBottom="@dimen/command_item_spacing"
            android:visibility="gone" />

        <com.yywspace.anethack.keybord.NHBottomCommandBar
            android:id="@+id/bottom_command_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background" />
    </LinearLayout>

    <!-- 菜单容器：全屏覆盖地图和键盘，透明边缘也拦截点击 -->
    <FrameLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:background="@color/dialog_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible" />

    <!-- 仅资源更新时 inflate 的透明加载层 -->
    <ViewStub
        android:id="@+id/asset_loading_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_asset_loading" />

</FrameLayout>
