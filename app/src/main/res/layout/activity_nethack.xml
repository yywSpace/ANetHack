<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_container"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:clickable="true"
    tools:context=".NetHackActivity">

    <!-- 地图、键盘、命令面板从上到下排列：键盘弹出时地图被顶上去（缩小），
         而不是被键盘盖住，这样地图的可见高度就是它真实的 measuredHeight -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.yywspace.anethack.map.NHMapSurfaceView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </com.yywspace.anethack.map.NHMapSurfaceView>

        <!-- 状态栏与消息栏是透明的，允许叠在地图上 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true">

            <com.yywspace.anethack.map.NHStatusView
                android:id="@+id/status_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.yywspace.anethack.map.NHMessageView
                android:id="@+id/message_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 菜单叠加在地图上（键盘上方），不覆盖键盘与命令面板 -->
        <FrameLayout
            android:id="@+id/dialog_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:visibility="invisible" />
    </FrameLayout>

    <com.yywspace.anethack.keybord.KeyboardView
        android:id="@+id/keyboard_view"
        android:background="@color/app_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:key_height="@dimen/command_item_height" />

    <!-- 底部命令栏：命令按钮一行横向滚动，键盘开关固定在最右侧 -->
    <com.yywspace.anethack.keybord.NHBottomCommandPanel
        android:id="@+id/bottom_command_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background" />

</LinearLayout>
